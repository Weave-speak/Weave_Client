{
  "name": "weave-client",
  "version": "0.1.42",
  "description": "The Weave client — self-hosted voice, video and text chat for small groups",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:desktop": "vite --mode desktop",
    "build": "vite build",
    "build:desktop": "vite build --mode desktop",
    "preview": "vite preview",
    "test": "eslint . && node --test",
    "art": "node scripts/make-installer-art.mjs",
    "electron:dev": "electron .",
    "pack": "npm run art && npm run build:desktop && electron-builder --win --publish never",
    "release": "node scripts/ensure-release.mjs && npm run art && npm run build:desktop && electron-builder --win --publish always && node scripts/finish-release.mjs",
    "lint": "eslint .",
    "predict-delta": "node scripts/predict-delta.mjs",
    "ensure-release": "node scripts/ensure-release.mjs",
    "finish-release": "node scripts/finish-release.mjs"
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "mediasoup-client": "^3.22.0"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "26.15.7",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "vite": "^8.2.2"
  },
  "author": {
    "name": "The Weave contributors"
  },
  "homepage": "https://github.com/Weave-speak/Weave_Client",
  "repository": {
    "type": "git",
    "url": "https://github.com/Weave-speak/Weave_Client.git"
  },
  "main": "electron/main.js",
  "productName": "Weave"
}
